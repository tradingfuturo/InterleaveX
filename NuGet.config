<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="./packages"/>
    <add key="repositoryPath" value="./packages"/>
  </config>
  <packageSources>
    <clear/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
    <!--
      Release only. Packing emits into 'bin/$(Configuration)/nuget' but this value cannot vary by
      configuration, and the mapping below routes InterleaveX* here exclusively, so a package built
      in another configuration would simply not be found. 'Scripts/build.ps1' refuses -nuget in any
      other configuration for that reason, and CI downloads its package artifact into this same path.
    -->
    <add key="local" value="./bin/Release/nuget"/>
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="InterleaveX*" />
      <package pattern="Microsoft.Coyote*" />
    </packageSource>
  </packageSourceMapping>
</configuration>