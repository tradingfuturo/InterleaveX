<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>InterleaveX systematic testing engine (a fork of Microsoft Coyote).</Description>
    <AssemblyName>Microsoft.Coyote.Test</AssemblyName>
    <RootNamespace>Microsoft.Coyote.Test</RootNamespace>
    <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
    <Framework462Supported>false</Framework462Supported>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>InterleaveX.Test</PackageId>
    <PackageTags>systematic-testing;specifications;concurrency;dotnet;csharp</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>
  <Import Project="..\..\Common\build.props" />
  <Import Project="..\..\Common\key.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.20.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <!-- 0.11.5 is the floor: 0.11.4 writes field RVA data into a section that is only 4-aligned and
         packs the blobs back-to-back, so one odd-sized blob misaligns every blob after it. That
         silently breaks RuntimeHelpers.CreateSpan (constant ReadOnlySpan<T>) for every T wider than a
         byte in EVERY rewritten assembly. See SpanDataRewritingTests. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.2" />
    <PackageReference Include="xunit.abstractions" Version="2.0.3" />
  </ItemGroup>
  <!-- Microsoft.Extensions.Hosting.Abstractions carries BackgroundService, which the hosting model in
       Rewriting/Types/Hosting replaces. It is referenced as a PACKAGE rather than through the
       Microsoft.AspNetCore.App shared framework, matching Microsoft.AspNetCore.Http.Abstractions above:
       a FrameworkReference would make this assembly loadable only on a machine with that framework
       installed, and it is loaded by every rewritten test host. The netstandard2.0 target needs neither,
       since the model is #if NET. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Source\Core\Core.csproj" />
    <ProjectReference Include="..\..\Source\Actors\Actors.csproj" />
  </ItemGroup>
</Project>
