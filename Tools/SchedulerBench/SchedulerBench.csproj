<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Benchmark harness for the systematic testing runtime.</Description>
    <AssemblyName>SchedulerBench</AssemblyName>
    <RootNamespace>Microsoft.Coyote.Benchmarking.Scheduler</RootNamespace>
    <OutputType>Exe</OutputType>
    <OutputPath>.\bin\</OutputPath>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <NetStandard2Supported>false</NetStandard2Supported>
    <Framework462Supported>false</Framework462Supported>
    <Net6Supported>false</Net6Supported>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn),1591</NoWarn>
  </PropertyGroup>
  <Import Project="..\..\Common\build.props" />
  <Import Project="..\..\Common\key.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\Source\Test\Test.csproj" />
    <ProjectReference Include="..\Coyote\Coyote.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <!-- The harness must rewrite itself, else the injected call-site prologue that the
       measured optimizations target is never exercised by the workloads below. -->
  <Target Name="CoyoteRewriteWin" AfterTargets="AfterBuild" Condition="'$(OS)'=='Windows_NT'">
    <Exec Command="..\..\bin\$(TargetFramework)\interleavex.exe rewrite $(OutputPath)$(AssemblyName).dll" />
  </Target>
  <Target Name="CoyoteRewriteUnix" AfterTargets="AfterBuild" Condition="'$(OS)'!='Windows_NT'">
    <Exec Command="dotnet ../../bin/$(TargetFramework)/interleavex.dll rewrite $(OutputPath)$(AssemblyName).dll" />
  </Target>
</Project>
