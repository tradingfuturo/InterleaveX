<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The Coyote benchmark runner.</Description>
    <AssemblyName>BenchmarkRunner</AssemblyName>
    <RootNamespace>Microsoft.Coyote.Benchmarking</RootNamespace>
    <OutputType>Exe</OutputType>
    <OutputPath>.\bin\$(Configuration)\</OutputPath>
    <NetStandard2Supported>false</NetStandard2Supported>
    <Framework462Supported>false</Framework462Supported>
    <Net6Supported>false</Net6Supported>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
  <Import Project="..\..\Common\build.props" />
  <Import Project="..\..\Common\key.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\Tests\Tests.Performance\Tests.Performance.csproj" />
    <ProjectReference Include="..\..\Tests\Tests.Actors.Performance\Tests.Actors.Performance.csproj" />
    <ProjectReference Include="..\Coyote\Coyote.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.1" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.10.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
  <!--
    Resolved when the target runs rather than at evaluation, because the CLI this project references
    has not been built yet when the project is loaded, and both probes would miss it.

    'run-benchmark-history.ps1' restores this project over every commit it measures, so the rewrite
    step has to find the CLI in the layout of the commit being built as well as in today's. The
    fallback is the pre-'Separate debug and release build output' shape, which is what the fork's
    first 34 commits emit. The probe is on the managed assembly: it is there in both layouts on every
    platform, while the apphost is Windows-only.
  -->
  <Target Name="ResolveInterleaveXCli">
    <PropertyGroup>
      <_InterleaveXCliDir>$(MSBuildThisFileDirectory)../../bin/$(Configuration)/$(TargetFramework)</_InterleaveXCliDir>
      <_InterleaveXCliDir Condition="!Exists('$(_InterleaveXCliDir)/interleavex.dll')">$(MSBuildThisFileDirectory)../../bin/$(TargetFramework)</_InterleaveXCliDir>
    </PropertyGroup>
  </Target>
  <Target Name="CoyoteRewriteWin" AfterTargets="AfterBuild" DependsOnTargets="ResolveInterleaveXCli" Condition="'$(OS)'=='Windows_NT'">
    <Exec Command="&quot;$(_InterleaveXCliDir)/interleavex.exe&quot; rewrite $(OutputPath)Tests.Performance.dll" />
  </Target>
  <Target Name="CoyoteRewriteUnix" AfterTargets="AfterBuild" DependsOnTargets="ResolveInterleaveXCli" Condition="'$(OS)'!='Windows_NT'">
    <Exec Command="dotnet &quot;$(_InterleaveXCliDir)/interleavex.dll&quot; rewrite $(OutputPath)Tests.Performance.dll" />
  </Target>
</Project>